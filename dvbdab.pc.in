prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: dvbdab
Description: DAB/DAB+ receiver library for DVB satellite streams
Version: 1.0.2
Requires: pugixml
# a static C++ library: users link the C++ runtime as well
Libs: -L${libdir} -ldvbdab -lpthread -lz -lstdc++
Cflags: -I${includedir}
